[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='Yaru-magenta-dark'
icon-theme='Yaru-purple-dark'
font-name='Ubuntu Sans 11'
document-font-name='Ubuntu Sans 11'
monospace-font-name='Ubuntu Sans Mono 10.5'
cursor-theme='Yaru'
clock-format='24h'
clock-show-weekday=true
clock-show-date=true

[org.gnome.desktop.input-sources]
sources=[('xkb', 'us'), ('xkb', 'ru')]

[org.gnome.shell]
enabled-extensions=['ding@rastersoft.com', 'ubuntu-appindicators@ubuntu.com', 'ubuntu-dock@ubuntu.com', 'tiling-assistant@ubuntu.com', 'gsconnect@andyholmes.github.io']
favorite-apps=['localzet-launcher.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Software.desktop']

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
autohide=true
intellihide=true
show-favorites=true
show-mounts=false
dock-fixed=false
extend-height=false
transparency-mode='DYNAMIC'
dash-max-icon-size=42
