#!/usr/bin/env bash
set -euo pipefail
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  echo 'XDG_RUNTIME_DIR is required (start via a display manager).' >&2
  exit 1
fi
export XDG_CURRENT_DESKTOP=Localzet
export XDG_SESSION_DESKTOP=localzet
export XDG_SESSION_TYPE=wayland
export XDG_CONFIG_DIRS="/usr/local/share/localzet-os/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
exec /usr/bin/labwc -C /usr/local/share/localzet-os/labwc
