#!/usr/bin/env bash
# Signal readiness only after the GNOME Wayland shell stays available.
set -euo pipefail
[[ "${XDG_SESSION_TYPE:-}" == wayland && -n "${WAYLAND_DISPLAY:-}" ]] || exit 1
[[ -w /dev/ttyS0 ]] || exit 1
process_running() {
    local expected="$1" proc executable
    for proc in /proc/[0-9]*; do
        [[ -r "$proc/status" ]] || continue
        [[ "$(stat -c %u "$proc" 2>/dev/null)" == "$(id -u)" ]] || continue
        executable="$(readlink "$proc/exe" 2>/dev/null || true)"
        [[ "${executable##*/}" == "$expected" ]] && return 0
    done
    return 1
}
for _ in $(seq 1 60); do
    if process_running gnome-shell; then
        # A process existing briefly does not prove a usable GNOME session.
        sleep 12
        process_running gnome-shell || continue
        printf 'LOCALZET_GUI_SESSION_READY_V4_GNOME\n' > /dev/ttyS0
        exit 0
    fi
    sleep 1
done
echo 'GNOME Shell did not remain available in the Wayland session' >&2
exit 1
