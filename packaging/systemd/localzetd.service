[Unit]
Description=Localzet OS daemon
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/localzetd
RuntimeDirectory=localzet-os
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
